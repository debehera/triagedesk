# Copy to .env and fill in. NEVER commit .env.
# Windows PowerShell:  Copy-Item .env.example .env
# macOS / Linux:       cp .env.example .env

# --- API access -------------------------------------------------------------
ANTHROPIC_API_KEY=your-key-here

# --- Models, one per role (verified 2026-11-15; re-check before deploy) ------
MODEL_CLASSIFIER=claude-haiku-5-5
MODEL_SUMMARIZER=claude-haiku-5-5
MODEL_DIAGNOSTICS=claude-sonnet-5-5
MODEL_RESOLVER=claude-sonnet-5-5

# --- Guardrails and budgets --------------------------------------------------
CONFIDENCE_THRESHOLD=0.70
MAX_LOOP_ITERATIONS=8
MAX_TOOL_CALLS=10
MAX_INPUT_TOKENS_PER_TICKET=20000
THREAD_SUMMARY_TRIGGER_MESSAGES=6
THREAD_SUMMARY_TRIGGER_TOKENS=3000

# --- Audit log ---------------------------------------------------------------
AUDIT_LOG_PATH=logs/audit.jsonl

# --- Web demo (used from Day 12) ---------------------------------------------
RATE_LIMIT_PER_MINUTE=5
DAILY_CALL_CAP=150
MAX_CONCURRENT_TRIAGES=2
REQUEST_TIMEOUT_SECONDS=60
# Set to true ONLY behind a proxy that sets X-Forwarded-For (e.g. on Render)
TRUSTED_PROXY=false

# --- Tests only (leave unset) ------------------------------------------------
# FAULT_INJECT={"get_user": "TIMEOUT_ONCE"}
